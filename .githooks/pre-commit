#!/bin/sh
# Pre-commit hook: keeps docs/versions.json in sync with the highest
# VersionUpdate class version. Runs automatically before every commit.
#
# To activate after cloning:
#   git config core.hooksPath .githooks

VERSIONS_DIR="src/Classes/VersionHandler/Versions"
DOCS_VERSIONS_FILE="docs/versions.json"

# Nothing to do if the Versions directory doesn't exist yet
if [ ! -d "$VERSIONS_DIR" ]; then
    exit 0
fi

# Find the highest version by natural numeric sort on each segment.
LATEST=$(find "$VERSIONS_DIR" -maxdepth 1 -name 'Version_*.php' 2>/dev/null \
    | while IFS= read -r f; do basename "$f" .php; done \
    | sed 's/^Version_//' \
    | tr '_' '.' \
    | sort -t. -k1,1n -k2,2n -k3,3n \
    | tail -1)

# Nothing to do if no version files exist
if [ -z "$LATEST" ]; then
    exit 0
fi

# Skip if this version is already recorded in versions.json
if grep -q "\"version\"[[:space:]]*:[[:space:]]*\"$LATEST\"" "$DOCS_VERSIONS_FILE" 2>/dev/null; then
    exit 0
fi

# Prepend the new version entry to the JSON array
TODAY=$(date -u +"%Y-%m-%d")
php -r "
    \$file = '$DOCS_VERSIONS_FILE';
    \$entries = file_exists(\$file) ? json_decode(file_get_contents(\$file), true) : [];
    if (!is_array(\$entries)) \$entries = [];
    array_unshift(\$entries, ['version' => '$LATEST', 'date' => '$TODAY']);
    file_put_contents(\$file, json_encode(\$entries, JSON_PRETTY_PRINT) . PHP_EOL);
"
git add "$DOCS_VERSIONS_FILE"
echo "docs/versions.json updated to include $LATEST"

exit 0
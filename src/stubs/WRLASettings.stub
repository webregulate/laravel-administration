<?php
namespace App\WRLA;

use Illuminate\Support\Facades\Route;
use WebRegulate\LaravelAdministration\Classes\WRLAHelper;
use WebRegulate\LaravelAdministration\Livewire\Dashboard;
use WebRegulate\LaravelAdministration\Livewire\FileManager;
use WebRegulate\LaravelAdministration\Livewire\Logs;
use WebRegulate\LaravelAdministration\Livewire\DatabaseSchema;
use WebRegulate\LaravelAdministration\Classes\NavigationItems\NavigationItem;

class WRLASettings
{
    /**
     * Build navigation for the WRLA application
     */
    public static function buildNavigation(): array
    {
        return [
            // Frontend, redirects to /
            NavigationItem::make(url: route('wrla.to-frontend'), name: 'Frontend', icon: 'fa fa-globe')->openInNewTab(true),

            // Dashboard
            NavigationItem::make(url: route('wrla.dashboard'), name: 'Dashboard', icon: 'fa fa-tachometer-alt'),

            // Divider
            NavigationItem::makeDivider('Site Management', 'fas fa-cog mr-1'),

            // Import manageable model nav items - If array is empty, all manageable models will be imported here
            NavigationItem::makeManageableModels(
                // \App\WRLA\User::class,
                // \App\WRLA\EmailTemplate::class,
                // ...
            ),

            // File Manager
            NavigationItem::make(url: route('wrla.file-manager'), name: 'File Manager', icon: 'fa fa-folder-open')->showOnCondition(fn() => 
                WRLAHelper::getCurrentUserData()?->isMaster() && config('wr-laravel-administration.file_manager.enabled', false)
            ),

            // View Logs
            NavigationItem::make(url: route('wrla.logs'), name: 'View Logs', icon: 'fa fa-file-alt')->showOnCondition(fn() =>
                WRLAHelper::getCurrentUserData()?->isMaster() && !empty(config('wr-laravel-administration.logs.current'))
            ),

            // Database Schema (albertoarena/laravel-truss)
            NavigationItem::make(url: route('wrla.database-schema'), name: 'Database Schema', icon: 'fas fa-diagram-project')->showOnCondition(fn() =>
                WRLAHelper::databaseSchemaViewerEnabled()
            ),

            // Divider
            NavigationItem::makeDivider('My Account', 'fa fa-user mr-1'),

            // Manage account
            NavigationItem::make(url: route('wrla.manage-account'), name: 'Manage Account', icon: 'fa fa-user-circle'),

            // Logout
            NavigationItem::make(url: route('wrla.logout'), name: 'Logout', icon: 'fa fa-sign-out-alt'),
        ];
    }

    /**
     * Build routes. Livewire routes should extend WRLAPageComponent.
     */
    public static function buildRoutes(): void
    {
        // Dashboard
        Route::get('dashboard', Dashboard::class)
            ->name('wrla.dashboard');

        // File manager - Enabled via `wr-laravel-administration.file_manager.enabled` configuration
        Route::get('file-manager', FileManager::class)
            ->name('wrla.file-manager');

        // View logs - Set via `wr-laravel-administration.logs.current` configuration
        Route::get('logs', Logs::class)
            ->name('wrla.logs');

        // Database schema viewer - Access via `wr-laravel-administration.database_schema_viewer.enabled` configuration
        Route::get('database-schema', DatabaseSchema::class)
            ->name('wrla.database-schema');

        // Custom route example
        // Route::get('url-route', MyComponent::class)
        //     ->name('wrla.my-component');
    }
}

<?php
namespace App\WRLA;

use Illuminate\Support\Facades\Route;
use WebRegulate\LaravelAdministration\Classes\WRLAHelper;
use WebRegulate\LaravelAdministration\Livewire\Dashboard;
use WebRegulate\LaravelAdministration\Livewire\FileManager;
use WebRegulate\LaravelAdministration\Livewire\Logs;
use WebRegulate\LaravelAdministration\Livewire\Scheduler;
use WebRegulate\LaravelAdministration\Livewire\DatabaseSchema;
use WebRegulate\LaravelAdministration\Classes\NavigationItems\NavigationItem;
use WebRegulate\LaravelAdministration\Enums\ManageableModelPermissions;

class WRLASettings
{
    /** Configure application runtime settings and callbacks. */
    public static function runtime(): array
    {
        return [
            // Default access rules for manageable models; individual models can override these.
            'default_manageable_model_permissions' => [
                ManageableModelPermissions::ENABLED->value => fn ($wrlaUserData) => $wrlaUserData?->isAdmin() ?? false,
                ManageableModelPermissions::CREATE->value => true,
                ManageableModelPermissions::BROWSE->value => true,
                ManageableModelPermissions::EDIT->value => true,
                ManageableModelPermissions::DELETE->value => true,
                ManageableModelPermissions::RESTORE->value => true,
                ManageableModelPermissions::SHOW_IN_NAV->value => true,
            ],

            // Developer tools access and available commands.
            'developer' => [
                // Access rules receive the current user's WRLA user data.
                'enable' => fn ($wrlaUserData) => $wrlaUserData?->isMaster() ?? false,

                // Commands available in developer tools; condition accepts a bool or callback.
                'commands' => [
                    [
                        'command' => 'php artisan wrla:update --no-interaction',
                        'label' => 'Update WRLA',
                        'condition' => true,
                        'refresh' => true,
                    ],
                    [
                        'command' => 'php artisan optimize:clear',
                        'label' => 'Clear All Cache',
                        'condition' => true,
                        'refresh' => false,
                    ],
                ],
            ],

            // Show the documentation link for these users.
            'documentation' => [
                'show_link' => fn ($wrlaUserData) => $wrlaUserData?->isMaster() ?? false,
            ],

            // null uses the WRLA avatar; a callback receives the User model and returns a URL.
            'user_avatar' => null,

            // Each group callback returns a collection of User models.
            'user_groups' => [
                'admin' => fn () => WRLAHelper::getUserModelClass()::whereIn(
                    'id',
                    WRLAHelper::getUserDataModelClass()::whereJsonContains('permissions', ['admin' => true])->get()->pluck('user_id'),
                )->get(),
            ],

            // Identifier linking the User model to its WRLA user data.
            'build_wrla_user_data_id' => fn (mixed $user) => $user->id,

            // Middleware applied before WRLA commands run.
            'middleware' => [
                'commands' => [],
            ],

            // Access and editing permissions for the database browser.
            'database_browser' => [
                // null uses developer access; bool or callback sets an independent rule.
                'enabled' => null,
                // These rules cannot bypass connection/table restrictions or read-only mode.
                'permissions' => [
                    'create' => true,
                    'edit' => true,
                    'delete' => true,
                ],
            ],

            // Access to the database schema diagram.
            'database_schema_viewer' => [
                // null uses developer access; bool or callback sets an independent rule.
                'enabled' => null,
            ],

            // Access to scheduled jobs and manual runs.
            'scheduler' => [
                // null uses developer access; bool or callback sets an independent rule.
                'enabled' => null,
                // null uses scheduler access; bool or callback sets an independent rule.
                'can_run_adhoc' => null,
            ],
        ];
    }

    /** Build navigation for the WRLA application */
    public static function buildNavigation(): array
    {
        return [
            // Frontend, redirects to /
            NavigationItem::make(url: route('wrla.to-frontend'), name: 'Frontend', icon: 'fa fa-globe')->openInNewTab(true),

            // Dashboard
            NavigationItem::make(url: route('wrla.dashboard'), name: 'Dashboard', icon: 'fa fa-tachometer-alt'),

            // Divider
            NavigationItem::makeDivider('Site Management', 'fas fa-cog mr-1'),

            // Import manageable model nav items - If array is empty, all manageable models will be imported here
            NavigationItem::makeManageableModels(
                // \App\WRLA\User::class,
                // \App\WRLA\EmailTemplate::class,
                // ...
            ),

            // File Manager
            NavigationItem::make(url: route('wrla.file-manager'), name: 'File Manager', icon: 'fa fa-folder-open')->showOnCondition(fn() => 
                WRLAHelper::getCurrentUserData()?->isMaster() && config('wrla.file_manager.enabled', false)
            ),

            // Scheduler & Jobs
            NavigationItem::make(url: route('wrla.scheduler'), name: 'Scheduler & Jobs', icon: 'fa fa-clock-rotate-left')->showOnCondition(fn() =>
                WRLAHelper::schedulerEnabled()
            ),

            // View Logs
            NavigationItem::make(url: route('wrla.logs'), name: 'View Logs', icon: 'fa fa-file-alt')->showOnCondition(fn() =>
                WRLAHelper::getCurrentUserData()?->isMaster() && !empty(config('wrla.logs.current'))
            ),

            // Divider
            NavigationItem::makeDivider('My Account', 'fa fa-user mr-1'),

            // Manage account
            NavigationItem::make(url: route('wrla.manage-account'), name: 'Manage Account', icon: 'fa fa-user-circle'),

            // Logout
            NavigationItem::make(url: route('wrla.logout'), name: 'Logout', icon: 'fa fa-sign-out-alt'),
        ];
    }

    /** Build routes. Livewire routes should extend WRLAPageComponent. */
    public static function buildRoutes(): void
    {
        // Dashboard
        Route::get('dashboard', Dashboard::class)
            ->name('wrla.dashboard');

        // File manager - Enabled via `wrla.file_manager.enabled` configuration
        Route::get('file-manager', FileManager::class)
            ->name('wrla.file-manager');

        // Database schema viewer - Access is configured in runtime().
        Route::get('database-schema', DatabaseSchema::class)
            ->name('wrla.database-schema');

        // Scheduler & Jobs - Access is configured in runtime().
        Route::get('scheduler', Scheduler::class)
            ->name('wrla.scheduler');

        // View logs - Set via `wrla.logs.current` configuration
        Route::get('logs', Logs::class)
            ->name('wrla.logs');
    }
}

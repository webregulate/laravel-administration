<?php

namespace App\WRLA;

use Exception;
use Illuminate\Support\Str;
use Illuminate\Database\Eloquent\Builder;
use WebRegulate\LaravelAdministration\Classes\ManageableModel;
use WebRegulate\LaravelAdministration\Classes\WRLAHelper;
use WebRegulate\LaravelAdministration\Classes\InstanceActions\InstanceActionRestore;
use WebRegulate\LaravelAdministration\Classes\InstanceActions\InstanceActionEdit;
use WebRegulate\LaravelAdministration\Classes\InstanceActions\InstanceActionDelete;
use WebRegulate\LaravelAdministration\Classes\NavigationItems\NavigationItemBrowse;
use WebRegulate\LaravelAdministration\Classes\NavigationItems\NavigationItemCreate;
use WebRegulate\LaravelAdministration\Classes\ManageableFields\BladeElement;
use WebRegulate\LaravelAdministration\Classes\ManageableFields\Json;
use WebRegulate\LaravelAdministration\Classes\ManageableFields\Text;
use WebRegulate\LaravelAdministration\Classes\ManageableFields\TextArea;
use WebRegulate\LaravelAdministration\Classes\ManageableFields\Select;
use WebRegulate\LaravelAdministration\Classes\BrowseActions\BrowseActionCreate;
use WebRegulate\LaravelAdministration\Classes\BrowseActions\BrowseActionImport;
use WebRegulate\LaravelAdministration\Classes\BrowseActions\BrowseActionExportCSV;
use WebRegulate\LaravelAdministration\Classes\BrowseFilters\BrowseFilterSearch;
use WebRegulate\LaravelAdministration\Classes\BrowseFilters\BrowseFilterSoftDeleted;

class EmailTemplate extends ManageableModel
{
    /**
     * Setup the main properties of the model.
     */
    public final static function mainSetup(): void
    {
        static::setBaseModelClass(\WebRegulate\LaravelAdministration\Models\EmailTemplate::class);
        static::setDisplayName();
        static::setUrlAlias('email-template');
        static::setIcon('fas fa-palette');

        // Navigation
        static::setNavigationItems(fn () => [
            NavigationItemBrowse::make(static::class),
            NavigationItemCreate::make(static::class),
        ]);
    }

    /**
     * Setup browse properties of this manageable model.
     */
    public final static function browseSetup(): void
    {
        // Browse filters
        static::setBrowseFilters(
            BrowseFilterSelect::make(
                alias: 'categoryFilter',
                label: 'Category',
                icon: 'fa-solid fa-tag',
                filterColumn: 'category',
                displayColumn: 'category',
                source: [
                    'transactional' => 'Transactional',
                    'marketing' => 'Marketing',
                    'training_courses' => 'Training Courses',
                ]
            ),
            BrowseFilterSearch::make(static::class),
            BrowseFilterSoftDeleted::make(static::class),
        );

        // Browse actions
        static::setBrowseActions(
            BrowseActionCreate::make(static::class),
            BrowseActionImport::make(static::class),
            BrowseActionExportCSV::make(static::class),
        );

        // Enable multi selection
        static::setMultiSelect(true);

        // Order by
        static::setOrderBy('category', 'desc');
    }

    /**
     * Provide an array of columns to display in the browse view.
     */
    public final function getBrowseColumns(): array
    {
        return [
            'category' => 'Category',
            'alias' => 'Alias',
        ];
    }

    /**
     * Provide the model instance actions.
     */
    public final function getInstanceActions(): array
    {
        $user = WRLAHelper::getCurrentUser();
        $defaultEmails = $user->email ?? null;

        return [
            // Send test action
            $this->instanceAction('Send Test', 'fa fa-paper-plane', 'secondary')
                ->requireCondition(fn() => !empty($defaultEmails))
                // Prompt for one or more recipients (comma separated), pre-filled with the current user's email.
                ->ask('Send test email to (comma separated for multiple, save changes first):', false, $defaultEmails)
                ->setAction(function($emailTemplate, $parameters) use ($user) {
                    // Normalise the comma delimited input into a clean, validated list
                    $emailsRaw = $parameters['input'] ?? '';
                    $emails = collect(explode(',', $emailsRaw))
                        ->map(fn($email) => trim($email))
                        ->filter(fn($email) => $email !== '' && filter_var($email, FILTER_VALIDATE_EMAIL))
                        ->values()
                        ->all();

                    if(empty($emails)) {
                        return "No valid email addresses provided: {$emailsRaw}";
                    }

                    try {
                        // Set data array for injections. Any keys not provided here
                        // will fall back to string defaults defined in the template's
                        // mappings JSON (handled by EmailTemplate::applyCustomisedDataValues).
                        $emailTemplate->setDataArray([
                            'user' => $user,
                        ]);

                        // sendEmail() accepts an array or comma delimited string of recipients
                        $success = $emailTemplate->sendEmail($emails);

                        // Return a message indicating success or failure, along with the list of recipients
                        return ($success ? 'Email successfully sent to ' : 'Failed to send email to ') . implode(', ', $emails);
                    } catch (Exception $e) {
                        return "Error sending email: " . $e->getMessage();
                    }
                }),

            // Default actions
            InstanceActionRestore::make($this),
            InstanceActionEdit::make($this),
            InstanceActionDelete::make($this, $this->isModelSoftDeleted()),
        ];
    }

    /**
     * Provide an array of manageable fields to display in the upsert view.
     */
    public final function getManageableFields(): array
    {
        return [
            Text::make($this, 'alias')
                ->required()
                ->validation('string|min:3|max:255')
                ->notes('Minimum 5 characters. After set and in use, do not change this value.'),

            Select::make($this, 'type')->setLabel('Type')
                ->required()
                ->default('markdown')
                ->setItems([
                    'markdown' => 'Markdown',
                    'html' => 'HTML',
                ]),

            Json::make($this, 'mappings')->setLabel('Mappings')
                ->hideContainingBraces()
                ->default('"user": {
        "id": null,
        "name": null,
        "email": null
}')
                ->setAttributes([
                    'autocorrect' => 'false',
                    'spellcheck' => 'false',
                ]),

            Text::make($this, 'description')->setLabel('Short description')
                ->setAttributes([
                    'autocorrect' => 'false',
                    'spellcheck' => 'false',
                ]),

            Select::make($this, 'category')
                ->required()
                ->setItems([
                    'transactional' => 'Transactional',
                ]),

            Text::make($this, 'subject')
                ->setLivewireModel('live.debounce.500ms')
                ->default('Subject text')
                ->required(),

            TextArea::make($this, 'body')
                ->setLivewireModel('live.debounce.500ms')
                ->setAttributes([
                    'autocorrect' => 'false',
                    'spellcheck' => 'false',
                    (WRLAHelper::isEditPage() ? 'autofocus' : 'donothing') => 'true',
                    'x-ref' => 'bodyTextArea',
                    'rows' => 10,
                ])
                ->default('Body text')
                ->required(),

            EmailTemplate::buildEmailTemplateBladeElement($this, $this->model()),
        ];
    }

    public static function buildEmailTemplateBladeElement(ManageableModel $manageableModel, \WebRegulate\LaravelAdministration\Models\EmailTemplate|callable $emailTemplate): BladeElement
    {
        return BladeElement::make($manageableModel, null, function($bladeElement) use ($emailTemplate) {
            if(is_callable($emailTemplate)) {
                $emailTemplate = $emailTemplate();
            }

            // Set up the email template example data
            $emailTemplate->setDataArray([
                'user' => [
                    'id' => 1,
                    'name' => 'John Doe',
                    'email' => 'john.doe@domain.com',
                ]
            ]);

            $emailTemplate->subject = ManageableModel::getLivewireField('subject');
            $emailTemplate->body = ManageableModel::getLivewireField('body');
            $emailTemplate->type = ManageableModel::getLivewireField('type') ?: $emailTemplate->type;

            // Inject variables into the blade variables
            $subject = $emailTemplate->getFinalSubject($emailTemplate::RENDER_MODE_BLADE);
            // Render the full email HTML and escape it for the iframe srcdoc, so the
            // preview displays with its natural HTML styling, isolated from Tailwind.
            $iframeSrcdoc = htmlspecialchars($emailTemplate->renderEmail($emailTemplate::RENDER_MODE_EMAIL), ENT_QUOTES);
            $mappingsList = $emailTemplate->getMappingsListFormattedHTML();

            // Return the blade element
            return <<<HTML
                <div class="relative w-full" style="top: -22px;">
                    <div class="border border-slate-300 mt-2 p-3">
                        <b class="font-medium">Available key mappings (click to inject):</b><br />
                        $mappingsList
                    </div>
                    <div class="relative border border-slate-300 mt-2 p-3">
                        <div wire:loading class="absolute top-2 right-4 flex justify-end items-center gap-2 font-medium text-slate-600 text-sm">
                            <i class="fas fa-spinner animate-spin inline-block"></i>
                            <span style="padding-left: 4px;">Loading...</span>
                        </div>
                        <b class="font-medium mb-1">Preview:</b><br />
                        <div style="background: white; margin-bottom: 10px; width:100%; font-weight: 600; border: 1px solid #cccccc; border-radius: 6px; padding: 15px 10px; background:#ffffff; display:block;">
                            $subject
                        </div>
                        <div style="border: 1px solid #cccccc; border-radius: 6px; padding: 15px; background:#ffffff;">
                            @verbatim
                            <iframe
                                srcdoc="$iframeSrcdoc"
                                title="Email preview"
                                scrolling="no"
                                style="box-sizing:content-box; width:100%; min-height:150px; border:0; background:#ffffff; display:block;"
                                onload="this.style.height=(this.contentWindow.document.documentElement.scrollHeight + 2)+'px';"
                            ></iframe>
                            @endverbatim
                        </div>
                    </div>
                </div>
            HTML;
        });
    }
}
